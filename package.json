{
  "name": "dsh-desktop",
  "productName": "DSH桌面版",
  "version": "1.0.0",
  "description": "DeepSeek Harness (DSH) 桌面封装：一键启动 dsh web，关闭窗口即停止服务",
  "main": "main.js",
  "author": "local",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node generate-icon.js",
    "dist": "electron-builder --win portable",
    "dist:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.dsh-desktop",
    "productName": "DSH桌面版",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "loading.html",
      "config.json",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "DSH桌面版-${version}.exe"
    },
    "afterPack": "tools/after-pack.js"
  }
}
